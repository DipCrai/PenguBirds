+RECOMP_WS2(21, setsockopt, 5) {
+  int fd = SocketFd(Arg(c, 0));
+  if (fd < 0) return Fail(kWsaENotSock);
+  int hl, kind;
+  int ho = HostOpt(int(Arg(c, 1)), int(Arg(c, 2)), &hl, &kind);
+  gaddr val = Arg(c, 3);
+  uint32_t len = uint32_t(Arg(c, 4));
+  if (ho < 0) return Fail(kWsaENoProtoOpt);
+  if (!val) return Fail(kWsaEInval);
+  if (kind == 1) {
+    if (len < 4) return Fail(kWsaEInval);
+    linger l{};
+    uint8_t b[4];
+    std::memcpy(b, GPtr(val), 4);
+    std::memcpy(&l, b, 4);
+    return ::setsockopt(fd, hl, ho, &l, sizeof l) == 0 ? 0 : FailErrno();
+  }
+  if (kind == 2) {
+    if (len < 4) return Fail(kWsaEInval);
+    uint32_t ms = Rd32(val);
+    timeval tv{};
+    tv.tv_sec = ms / 1000;
+    tv.tv_usec = (ms % 1000) * 1000;
+    return ::setsockopt(fd, hl, ho, &tv, sizeof tv) == 0 ? 0 : FailErrno();
+  }
+  if (len > 64) return Fail(kWsaEInval);
+  uint8_t b[64];
+  std::memcpy(b, GPtr(val), len);
+  return ::setsockopt(fd, hl, ho, b, socklen_t(len)) == 0 ? 0 : FailErrno();
+}
