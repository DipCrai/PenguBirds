+void AttachImportedDlls(Ctx& c) {
+  std::lock_guard<std::recursive_mutex> l(g_loader_mu);
+  for (Module& m : g_win32->modules) {
+    if (m.refs) continue;
+    bool imported = false;
+    for (const PeImport& imp : g_win32->img.imports)
+      if (NormaliseDll(imp.dll) == m.name) { imported = true; break; }
+    if (!imported) continue;
+    m.refs = 1;
+    if (!CallDllMain(c, m, kDllProcessAttach))
+      FatalF("%s: DllMain failed", m.name.c_str());
