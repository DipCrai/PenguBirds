+  sockaddr_storage sa{};
+  socklen_t len = sizeof sa;
+  if (::getpeername(fd, reinterpret_cast<sockaddr*>(&sa), &len) != 0) return FailErrno();
+  ToGuest(sa, Arg(c, 1), Arg(c, 2));
