+
+// ---- socket options ---------------------------------------------------------
+
+// Windows SOL_SOCKET is 0xFFFF and its SO_* numbers differ from BSD's.
+// kind: 0 raw, 1 struct linger (u_short pair to int pair), 2 timeval (a
+// DWORD of milliseconds).
+int HostOpt(int level, int opt, int* host_level, int* kind) {
+  *kind = 0;
+  if (level == 0xFFFF) {
+    *host_level = SOL_SOCKET;
+    switch (opt) {
+      case 0x2: return SO_ACCEPTCONN;
+      case 0x4: return SO_REUSEADDR;
+      case 0x8: return SO_KEEPALIVE;
+      case 0x10: return SO_DONTROUTE;
+      case 0x20: return SO_BROADCAST;
+      case 0x80: *kind = 1; return SO_LINGER;
+      case 0x100: return SO_OOBINLINE;
+      case 0x1001: return SO_SNDBUF;
+      case 0x1002: return SO_RCVBUF;
+      case 0x1005: *kind = 2; return SO_SNDTIMEO;
+      case 0x1006: *kind = 2; return SO_RCVTIMEO;
+      case 0x1007: return SO_ERROR;
+      case 0x1008: return SO_TYPE;
+      default: return -1;
+    }
+  }
+  if (level == 6) {  // IPPROTO_TCP
+    *host_level = IPPROTO_TCP;
+    if (opt == 1) return TCP_NODELAY;  // TCP_NODELAY
+    return -1;
+  }
+  if (level == 0) {  // IPPROTO_IP
+    *host_level = IPPROTO_IP;
+    switch (opt) {
+      case 3: return IP_TOS;
+      case 4: return IP_TTL;
+      default: return -1;
+    }
+  }
+  return -1;
+}
