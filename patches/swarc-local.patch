+// Every live notification's play cursor, compared with the previous poll:
+// an offset is reached when the cursor moved past it (or past the end and
+// back to the front, for a looping buffer).
+void NotifyLoop() {
+  std::unique_lock<std::mutex> l(g_nt_mu);
+  for (;;) {
+    g_nt_mu.unlock();
+    std::this_thread::sleep_for(std::chrono::milliseconds(4));
+    g_nt_mu.lock();
+    std::vector<std::shared_ptr<Notify>> live;
+    for (auto it = g_nt.begin(); it != g_nt.end();) {
+      auto n = it->lock();
+      if (!n) {
+        it = g_nt.erase(it);
+        continue;
+      }
+      live.push_back(std::move(n));
+      ++it;
+    }
+    l.unlock();
+    for (auto& n : live) {
+      auto* b = com::As<SoundBuffer>(n->buffer);
+      if (!b || b->primary || !b->data) continue;
+      const uint32_t size = uint32_t(b->data->bytes.size());
+      uint32_t cur;
+      bool playing;
+      {
+        std::lock_guard<std::mutex> ml(M().mu());
+        cur = uint32_t(PlayFrame(*b)) * b->data->fmt.block;
+        playing = b->playing && b->voice->state == audio::Voice::State::Playing;
+      }
+      std::lock_guard<std::mutex> nl(n->mu);
+      if (!playing) {  // stopped or paused: do not cross anything
+        n->last = cur;
+        n->primed = true;
+        n->was_playing = false;
+        continue;
+      }
+      if (!n->primed) {
+        n->last = cur;
+        n->primed = true;
+        n->was_playing = true;
+        continue;
+      }
+      // Starting to play from the top reaches offset 0.
+      const bool start = !n->was_playing && cur >= n->last;
+      const bool wrapped = cur < n->last;
+      for (const auto& p : n->pos) {
+        if (p.first >= size) continue;
+        const bool hit = start && p.first == 0
+                             ? true
+                             : wrapped ? (p.first > n->last || p.first <= cur)
+                                       : (p.first > n->last && p.first <= cur);
+        if (hit) SignalEventHandle(p.second, false);
+      }
+      n->last = cur;
+      n->was_playing = true;
+    }
+    l.lock();
+  }
+}
+
+void RegisterNotify(const std::shared_ptr<Notify>& n) {
+  std::lock_guard<std::mutex> l(g_nt_mu);
+  g_nt.push_back(n);
+  if (!g_nt_started) {
+    g_nt_started = true;
+    std::thread(NotifyLoop).detach();
+  }
+}
