+RECOMP_WS2(7, getsockopt, 5) {
+  int fd = SocketFd(Arg(c, 0));
+  if (fd < 0) return Fail(kWsaENotSock);
+  int hl, kind;
+  int ho = HostOpt(int(Arg(c, 1)), int(Arg(c, 2)), &hl, &kind);
+  gaddr val = Arg(c, 3), len_va = Arg(c, 4);
+  if (ho < 0) return Fail(kWsaENoProtoOpt);
+  if (!val || !len_va) return Fail(kWsaEInval);
+  uint32_t cap = Rd32(len_va);
+  if (kind == 1) {
+    linger l{};
+    socklen_t n = sizeof l;
+    if (::getsockopt(fd, hl, ho, &l, &n) != 0) return FailErrno();
+    uint8_t b[4];
+    std::memcpy(b, &l, 4);
+    std::memcpy(GPtr(val), b, std::min<uint32_t>(cap, 4));
+    Wr32(len_va, 4);
+    return 0;
+  }
+  if (kind == 2) {
+    timeval tv{};
+    socklen_t n = sizeof tv;
+    if (::getsockopt(fd, hl, ho, &tv, &n) != 0) return FailErrno();
+    if (cap < 4) return Fail(kWsaEInval);
+    Wr32(val, uint32_t(tv.tv_sec * 1000 + tv.tv_usec / 1000));
+    Wr32(len_va, 4);
+    return 0;
+  }
+  int v = 0;
+  socklen_t n = sizeof v;
+  if (::getsockopt(fd, hl, ho, &v, &n) != 0) return FailErrno();
+  if (cap < n) n = socklen_t(cap);
+  std::memcpy(GPtr(val), &v, n);
+  Wr32(len_va, uint32_t(n));
+  return 0;
+}
