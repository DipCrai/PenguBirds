+// inet_addr / inet_ntoa, as Winsock: a network-order address and a
+// per-thread text buffer.
+RECOMP_WS2(11, inet_addr, 1) {
+  uint32_t a = ::inet_addr(GStr(Arg(c, 0)).c_str());
+  return a;
+}
+
+RECOMP_WS2(12, inet_ntoa, 1) {
+  static thread_local uint32_t buf = 0;
+  if (!buf) buf = HeapAllocProcess(16, true);
+  in_addr a;
+  a.s_addr = uint32_t(Arg(c, 0));
+  PutStr(buf, ::inet_ntoa(a));
+  return buf;
+}
