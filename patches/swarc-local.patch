+HLE_NAMED("dsound.dll", "IDirectSoundNotify::SetNotificationPositions",
+          DSN_SetNotificationPositions, 3) {
+  Notify* n = NotifyObj(c);
+  uint32_t count = Arg(c, 1), list = Arg(c, 2);
+  if ((count && !list) || count > 1000) return DSERR_INVALIDPARAM;
+  auto* b = com::As<SoundBuffer>(n->buffer);
+  const uint32_t size = b && b->data ? uint32_t(b->data->bytes.size()) : 0;
+  std::vector<std::pair<uint32_t, uint32_t>> pos;
+  pos.reserve(count);
+  for (uint32_t i = 0; i < count; i++) {
+    uint32_t off = Rd32(list + 8 * i), ev = Rd32(list + 8 * i + 4);
+    if (off >= size || !ev) return DSERR_INVALIDPARAM;
+    pos.emplace_back(off, ev);
+  }
+  std::lock_guard<std::mutex> l(n->mu);
+  n->pos = std::move(pos);
+  return DS_OK;
+}
