+++ b/platforms/win32/src/win32/secur32.cpp
@@ -0,0 +1,706 @@
+// Schannel (secur32.dll) on the host's TLS stack: the client side of
+// SSPI, which the games' bundled libcurl 7.29 uses for HTTPS.
+//
+// InitSecurityInterfaceA hands out a guest SecurityFunctionTableA whose
+// entries are HLE thunks. A credential carries the TLS policy of the
+// SCHANNEL_CRED it was acquired with (protocols, certificate validation);
+// a security context is one host TLS session over memory BIOs.
+// InitializeSecurityContext feeds the peer's records and returns the token
+// to send; EncryptMessage and DecryptMessage map to the record layer, with
+// SecPkgContext_StreamSizes reporting the record overhead the caller must
+// leave room for.
+//
+// Ciphertext is only fed to the engine in whole TLS records, and the bytes
+// the engine has not consumed are reported as SECBUFFER_EXTRA: the caller
+// (Schannel's contract) keeps them and presents them again with the next
+// read, which is how partial records survive. Certificates are validated
+// against the host trust store, as Schannel validates against the Windows
+// one; a hostname mismatch is SEC_E_WRONG_PRINCIPAL.
+//
+// Server-side contexts (AcceptSecurityContext), message signing and
+// impersonation are not provided: they return SEC_E_UNSUPPORTED_FUNCTION,
+// which is what Windows returns for a package that does not implement an
+// optional service.
+
+#include <openssl/bio.h>
+#include <openssl/err.h>
+#include <openssl/ssl.h>
+#include <openssl/x509v3.h>
+
+#include <arpa/inet.h>
+
+#include <cstring>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <vector>
+
+#include "runtime/log.h"
+#include "win32/hle.h"
+#include "win32/kernel32_state.h"
+
+namespace recomp::hle {
+
+namespace {
+
+// SECURITY_STATUS and SSPI error codes (sspi.h).
+constexpr uint32_t kSecEOk = 0x00000000;
+constexpr uint32_t kSecIContinueNeeded = 0x00090312;
+constexpr uint32_t kSecIContextExpired = 0x00090317;
+constexpr uint32_t kSecEIncompleteMessage = 0x80090318;
+constexpr uint32_t kSecEInvalidHandle = 0x80090301;
+constexpr uint32_t kSecEUnsupportedFunction = 0x80090302;
+constexpr uint32_t kSecEInternalError = 0x80090304;
+constexpr uint32_t kSecEInvalidParameter = 0x80090305;
+constexpr uint32_t kSecEInvalidToken = 0x80090308;
+constexpr uint32_t kSecECertUnknown = 0x80090327;
+constexpr uint32_t kSecECertExpired = 0x80090328;
+constexpr uint32_t kSecEWrongPrincipal = 0x80090322;
+constexpr uint32_t kSecEUntrustedRoot = 0x80090325;
+constexpr uint32_t kSecEBufferTooSmall = 0x80090321;
+
+// SecBuffer types.
+constexpr uint32_t kSecBufferEmpty = 0;
+constexpr uint32_t kSecBufferData = 1;
+constexpr uint32_t kSecBufferToken = 2;
+constexpr uint32_t kSecBufferExtra = 5;
+constexpr uint32_t kSecBufferStreamTrailer = 6;
+constexpr uint32_t kSecBufferStreamHeader = 7;
+
+// QueryContextAttributes attributes.
+constexpr uint32_t kSecPkgAttrSizes = 0;
+constexpr uint32_t kSecPkgAttrStreamSizes = 4;
+
+// SCHANNEL_CRED flags and protocol bits (schannel.h).
+constexpr uint32_t kSchCredNoSenameCheck = 0x4;
+constexpr uint32_t kSchCredManualValidation = 0x8;
+constexpr uint32_t kSchCredAutoValidation = 0x20;
+constexpr uint32_t kSpProtSsl3Client = 0x8;
+constexpr uint32_t kSpProtTls1Client = 0x80;
+constexpr uint32_t kSpProtTls11Client = 0x100;
+constexpr uint32_t kSpProtTls12Client = 0x200;
+
+constexpr uint32_t kCredOutbound = 2;
+constexpr uint32_t kSchannelShutdown = 1;
+
+constexpr const char* kUnispName = "Microsoft Unified Security Protocol Provider";
+
+// A SecBufferDesc in guest memory: { ULONG ulVersion; ULONG cBuffers;
+// PSecBuffer pBuffers; }, each SecBuffer { ULONG cbBuffer; ULONG
+// BufferType; PVOID pvBuffer; }.
+struct SecBuf {
+  uint32_t cb, type, ptr;
+};
+
+uint32_t BufCount(gaddr desc) { return desc ? Rd32(desc + 4) : 0; }
+
+SecBuf GetBuf(gaddr desc, uint32_t i) {
+  gaddr b = Rd32(desc + 8) + i * 12;
+  return {Rd32(b), Rd32(b + 4), Rd32(b + 8)};
+}
+
+void SetBuf(gaddr desc, uint32_t i, uint32_t cb, uint32_t type, gaddr ptr) {
+  gaddr b = Rd32(desc + 8) + i * 12;
+  Wr32(b, cb);
+  Wr32(b + 4, type);
+  Wr32(b + 8, ptr);
+}
+
+// The credential acquired by AcquireCredentialsHandle: the TLS policy.
+struct Credential {
+  SSL_CTX* ssl_ctx = nullptr;
+  bool verify = true;
+  bool no_name_check = false;
+};
+
+// A security context: one TLS session, plus the tail of the record stream
+// the caller has given us but the engine has not consumed as a whole record
+// (memory BIOs only ever see complete records).
+struct TlsContext {
+  std::shared_ptr<Credential> cred;
+  SSL* ssl = nullptr;
+  BIO* rbio = nullptr;
+  BIO* wbio = nullptr;
+  uint32_t req_flags = 0;
+  bool shutdown = false;
+  std::vector<uint8_t> pending;
+};
+
+std::mutex g_mu;
+uint32_t g_next_id = 0x1000;
+std::map<uint32_t, std::shared_ptr<Credential>> g_creds;
+std::map<uint32_t, std::shared_ptr<TlsContext>> g_contexts;
+
+uint32_t NewId() { return g_next_id++; }
+
+uint32_t HandleId(gaddr h) { return h ? Rd32(h) : 0; }
+
+void PutHandle(gaddr h, uint32_t id) {
+  Wr32(h, id);
+  Wr32(h + 4, 0);
+}
+
+std::shared_ptr<Credential> FindCred(uint32_t id) {
+  std::lock_guard<std::mutex> l(g_mu);
+  auto it = g_creds.find(id);
+  return it == g_creds.end() ? nullptr : it->second;
+}
+
+std::shared_ptr<TlsContext> FindContext(uint32_t id) {
+  std::lock_guard<std::mutex> l(g_mu);
+  auto it = g_contexts.find(id);
+  return it == g_contexts.end() ? nullptr : it->second;
+}
+
+void LogOpenSsl(const char* what) {
+  unsigned long e = ERR_get_error();
+  if (!e) return;
+  char buf[256];
+  ERR_error_string_n(e, buf, sizeof buf);
+  WarnF("secur32: %s: %s\n", what, buf);
+}
+
+std::vector<uint8_t> Drain(BIO* b) {
+  std::vector<uint8_t> v;
+  size_t n = BIO_ctrl_pending(b);
+  if (!n) return v;
+  v.resize(n);
+  int got = BIO_read(b, v.data(), int(n));
+  if (got <= 0) return {};
+  v.resize(size_t(got));
+  return v;
+}
+
+// One record: 5-byte header, up to 16 KiB of payload plus the AEAD/CBC
+// overhead the maximum fragment allows.
+constexpr uint32_t kMaxRecord = 5 + 16384 + 2048;
+
+// Appends the caller's new bytes to whatever tail we kept, then feeds every
+// complete TLS record to the engine. The caller re-presents the bytes we
+// reported as SECBUFFER_EXTRA; those are already in `pending` or still in the
+// BIO, so only the bytes after them are new.
+void FeedRecords(TlsContext& cx, gaddr buf, uint32_t n) {
+  if (!n) return;
+  const uint8_t* in = GPtr(buf);
+  size_t skip = 0;
+  if (!cx.pending.empty()) {
+    if (n >= cx.pending.size() && std::memcmp(in, cx.pending.data(), cx.pending.size()) == 0)
+      skip = cx.pending.size();  // the caller presented our tail again
+    else {
+      WarnF("secur32: caller did not re-present the buffered record tail\n");
+      cx.pending.clear();
+    }
+  }
+  cx.pending.insert(cx.pending.end(), in + skip, in + n);
+  size_t fed = 0;
+  while (cx.pending.size() - fed >= 5) {
+    uint32_t len = (uint32_t(cx.pending[fed + 3]) << 8) | cx.pending[fed + 4];
+    if (len > kMaxRecord) {
+      WarnF("secur32: bad TLS record length %u\n", len);
+      cx.pending.clear();
+      return;
+    }
+    if (cx.pending.size() - fed < 5 + len) break;
+    BIO_write(cx.rbio, cx.pending.data() + fed, int(5 + len));
+    fed += 5 + len;
+  }
+  if (fed) cx.pending.erase(cx.pending.begin(), cx.pending.begin() + ptrdiff_t(fed));
+}
+
+// Pulls whole records the engine did not read back out of the BIO, in front
+// of the incomplete tail. `pending` is then every ciphertext byte the caller
+// has given us that the engine has not consumed, so the caller's replay of
+// our SECBUFFER_EXTRA is exactly a prefix of it.
+void Reclaim(TlsContext& cx) {
+  std::vector<uint8_t> held = Drain(cx.rbio);
+  if (held.empty()) return;
+  held.insert(held.end(), cx.pending.begin(), cx.pending.end());
+  cx.pending = std::move(held);
+}
+
+// Bytes the caller must keep for the next call: the unconsumed ciphertext.
+uint32_t ExtraBytes(TlsContext& cx) { return uint32_t(cx.pending.size()); }
+
+
+uint32_t VerifyStatus(SSL* ssl) {
+  switch (SSL_get_verify_result(ssl)) {
+    case X509_V_OK:
+      return kSecEOk;
+    case X509_V_ERR_HOSTNAME_MISMATCH:
+    case X509_V_ERR_IP_ADDRESS_MISMATCH:
+      return kSecEWrongPrincipal;
+    case X509_V_ERR_CERT_HAS_EXPIRED:
+    case X509_V_ERR_CERT_NOT_YET_VALID:
+      return kSecECertExpired;
+    case X509_V_ERR_DEPTH_ZERO_SELF_SIGNED_CERT:
+    case X509_V_ERR_SELF_SIGNED_CERT_IN_CHAIN:
+    case X509_V_ERR_UNABLE_TO_GET_ISSUER_CERT:
+    case X509_V_ERR_UNABLE_TO_GET_ISSUER_CERT_LOCALLY:
+    case X509_V_ERR_UNABLE_TO_VERIFY_LEAF_SIGNATURE:
+      return kSecEUntrustedRoot;
+    default:
+      return kSecECertUnknown;
+  }
+}
+
+bool IsIpLiteral(const std::string& s) {
+  unsigned char a[16];
+  return inet_pton(AF_INET, s.c_str(), a) == 1 || inet_pton(AF_INET6, s.c_str(), a) == 1;
+}
+
+// The SecurityFunctionTableA, built once: dwVersion then one pointer per
+// entry (sspi.h order). Entries Windows declares but nothing client-side
+// needs still point at real handlers, which answer with the documented
+// "this package does not do that" status.
+gaddr SecurityTable() {
+  static gaddr table = 0;
+  if (table) return table;
+  table = HeapAllocProcess(0x78, true);
+  Wr32(table + 0x00, 1);  // dwVersion
+  struct Entry {
+    uint32_t off;
+    const char* name;
+  };
+  static const Entry kEntries[] = {
+      {0x04, "EnumerateSecurityPackagesA"},
+      {0x08, "QueryCredentialsAttributesA"},
+      {0x0C, "AcquireCredentialsHandleA"},
+      {0x10, "FreeCredentialsHandle"},
+      {0x18, "InitializeSecurityContextA"},
+      {0x1C, "AcceptSecurityContext"},
+      {0x20, "CompleteAuthToken"},
+      {0x24, "DeleteSecurityContext"},
+      {0x28, "ApplyControlToken"},
+      {0x2C, "QueryContextAttributesA"},
+      {0x30, "ImpersonateSecurityContext"},
+      {0x34, "RevertSecurityContext"},
+      {0x38, "MakeSignature"},
+      {0x3C, "VerifySignature"},
+      {0x40, "FreeContextBuffer"},
+      {0x44, "QuerySecurityPackageInfoA"},
+      {0x50, "ExportSecurityContext"},
+      {0x54, "ImportSecurityContextA"},
+      {0x58, "AddCredentialsA"},
+      {0x60, "QuerySecurityContextToken"},
+      {0x64, "EncryptMessage"},
+      {0x68, "DecryptMessage"},
+  };
+  for (const Entry& e : kEntries) Wr32(table + e.off, ThunkFor("secur32.dll", e.name));
+  return table;
+}
+
+// Fills a SecPkgInfoA (fCapabilities, wVersion, wRPCID, cbMaxToken, Name,
+// Comment) in one guest block with its strings.
+gaddr PackageInfo() {
+  static const char kComment[] = "Schannel TLS client";
+  const uint32_t name_len = uint32_t(std::strlen(kUnispName) + 1);
+  const uint32_t comment_len = uint32_t(sizeof kComment);
+  gaddr p = HeapAllocProcess(24 + name_len + comment_len, false);
+  gaddr name = p + 24, comment = name + name_len;
+  // Integrity, privacy, stream, mutual auth.
+  Wr32(p + 0, 0x1 | 0x2 | 0x4 | 0x10);
+  Wr16(p + 4, 1);  // wVersion
+  Wr16(p + 6, 0x10);  // wRPCID
+  Wr32(p + 8, 0x4000);  // cbMaxToken
+  Wr32(p + 12, name);
+  Wr32(p + 16, comment);
+  std::memcpy(GPtr(name), kUnispName, name_len);
+  std::memcpy(GPtr(comment), kComment, comment_len);
+  return p;
+}
+
+uint32_t Unsupported() { return kSecEUnsupportedFunction; }
+
+}  // namespace
+
+// ---- the dispatch table --------------------------------------------------
+
+HLE("secur32.dll", InitSecurityInterfaceA, 0) { return SecurityTable(); }
+
+HLE("secur32.dll", EnumerateSecurityPackagesA, 2) {
+  gaddr count = Arg(c, 0), out = Arg(c, 1);
+  if (count) Wr32(count, 1);
+  if (out) Wr32(out, PackageInfo());
+  return kSecEOk;
+}
+
+HLE("secur32.dll", QuerySecurityPackageInfoA, 2) {
+  gaddr out = Arg(c, 1);
+  if (!out) return kSecEInvalidParameter;
+  Wr32(out, PackageInfo());
+  return kSecEOk;
+}
+
+HLE("secur32.dll", QueryCredentialsAttributesA, 3) { return Unsupported(); }
+HLE("secur32.dll", AcceptSecurityContext, 9) { return Unsupported(); }
+HLE("secur32.dll", ImpersonateSecurityContext, 1) { return Unsupported(); }
+HLE("secur32.dll", RevertSecurityContext, 1) { return Unsupported(); }
+HLE("secur32.dll", MakeSignature, 4) { return Unsupported(); }
+HLE("secur32.dll", VerifySignature, 3) { return Unsupported(); }
+HLE("secur32.dll", ExportSecurityContext, 4) { return Unsupported(); }
+HLE("secur32.dll", ImportSecurityContextA, 5) { return Unsupported(); }
+HLE("secur32.dll", AddCredentialsA, 5) { return kSecEOk; }
+HLE("secur32.dll", QuerySecurityContextToken, 2) { return Unsupported(); }
+
+// Schannel has no extra token to process after the last handshake flight.
+HLE("secur32.dll", CompleteAuthToken, 2) { return kSecEOk; }
+
+HLE("secur32.dll", AcquireCredentialsHandleA, 9) {
+  gaddr ph = Arg(c, 7);
+  if (!ph) return kSecEInvalidParameter;
+  gaddr auth = Arg(c, 4);  // SCHANNEL_CRED*
+  uint32_t flags = auth ? Rd32(auth + 0x30) : 0;
+  uint32_t protocols = auth ? Rd32(auth + 0x20) : 0;
+
+  auto cred = std::make_shared<Credential>();
+  // Schannel's default is automatic validation; manual means the caller
+  // checks the chain itself.
+  cred->verify = (flags & kSchCredManualValidation) == 0;
+  cred->no_name_check = (flags & kSchCredNoSenameCheck) != 0;
+
+  cred->ssl_ctx = SSL_CTX_new(TLS_client_method());
+  if (!cred->ssl_ctx) {
+    LogOpenSsl("SSL_CTX_new");
+    return kSecEInternalError;
+  }
+  // The engine's floor is TLS 1.2 (the host stack's default). A caller that
+  // asks for older protocols still gets at most 1.2, as a current Windows
+  // would negotiate for the same credential.
+  if (protocols) {
+    int maxv = (protocols & kSpProtTls12Client) ? TLS1_2_VERSION
+               : (protocols & kSpProtTls11Client) ? TLS1_1_VERSION
+               : (protocols & kSpProtTls1Client) ? TLS1_VERSION
+                                                 : SSL3_VERSION;
+    int minv = (protocols & kSpProtSsl3Client) ? SSL3_VERSION
+               : (protocols & kSpProtTls1Client) ? TLS1_VERSION
+               : (protocols & kSpProtTls11Client) ? TLS1_1_VERSION
+                                                  : TLS1_2_VERSION;
+    if (maxv > TLS1_2_VERSION) maxv = TLS1_2_VERSION;
+    if (minv > maxv) minv = maxv;
+    SSL_CTX_set_max_proto_version(cred->ssl_ctx, maxv);
+    SSL_CTX_set_min_proto_version(cred->ssl_ctx, minv);
+  }
+  if (cred->verify) {
+    SSL_CTX_set_default_verify_paths(cred->ssl_ctx);
+    SSL_CTX_set_verify(cred->ssl_ctx, SSL_VERIFY_PEER, nullptr);
+  } else {
+    SSL_CTX_set_verify(cred->ssl_ctx, SSL_VERIFY_NONE, nullptr);
+  }
+
+  uint32_t id;
+  {
+    std::lock_guard<std::mutex> l(g_mu);
+    id = NewId();
+    g_creds[id] = cred;
+  }
+  PutHandle(ph, id);
+  return kSecEOk;
+}
+
+HLE("secur32.dll", FreeCredentialsHandle, 1) {
+  uint32_t id = HandleId(Arg(c, 0));
+  std::shared_ptr<Credential> cred;
+  {
+    std::lock_guard<std::mutex> l(g_mu);
+    auto it = g_creds.find(id);
+    if (it == g_creds.end()) return kSecEInvalidHandle;
+    cred = it->second;
+    g_creds.erase(it);
+  }
+  if (cred->ssl_ctx) SSL_CTX_free(cred->ssl_ctx);
+  return kSecEOk;
+}
+
+HLE("secur32.dll", DeleteSecurityContext, 1) {
+  uint32_t id = HandleId(Arg(c, 0));
+  std::shared_ptr<TlsContext> cx;
+  {
+    std::lock_guard<std::mutex> l(g_mu);
+    auto it = g_contexts.find(id);
+    if (it == g_contexts.end()) return kSecEInvalidHandle;
+    cx = it->second;
+    g_contexts.erase(it);
+  }
+  if (cx->ssl) SSL_free(cx->ssl);  // also frees the BIOs
+  return kSecEOk;
+}
+
+HLE("secur32.dll", ApplyControlToken, 2) {
+  auto cx = FindContext(HandleId(Arg(c, 0)));
+  if (!cx) return kSecEInvalidHandle;
+  gaddr desc = Arg(c, 1);
+  SecBuf b = GetBuf(desc, 0);
+  if (b.type == kSecBufferToken && b.cb == 4 && Rd32(b.ptr) == kSchannelShutdown) {
+    cx->shutdown = true;
+    return kSecEOk;
+  }
+  return kSecEInvalidParameter;
+}
+
+HLE("secur32.dll", QueryContextAttributesA, 3) {
+  auto cx = FindContext(HandleId(Arg(c, 0)));
+  if (!cx) return kSecEInvalidHandle;
+  uint32_t attr = Arg(c, 1);
+  gaddr out = Arg(c, 2);
+  if (attr == kSecPkgAttrStreamSizes) {
+    if (!out) return kSecEInvalidParameter;
+    // TLS record: 5-byte header; the trailer carries the explicit IV, MAC
+    // and padding of the block cipher suites, which is what a caller must
+    // leave room for after each message.
+    Wr32(out + 0, 5);            // cbHeader
+    Wr32(out + 4, 1024);         // cbTrailer
+    Wr32(out + 8, 16384);        // cbMaximumMessage
+    Wr32(out + 12, 4);           // cBuffers
+    Wr32(out + 16, 16);          // cbBlockSize
+    return kSecEOk;
+  }
+  if (attr == kSecPkgAttrSizes) {
+    if (!out) return kSecEInvalidParameter;
+    Wr32(out + 0, 0x4000);  // cbMaxToken
+    Wr32(out + 4, 0);       // cbMaxSignature
+    Wr32(out + 8, 16);      // cbBlockSize
+    Wr32(out + 12, 1024);   // cbSecurityTrailer
+    return kSecEOk;
+  }
+  return Unsupported();
+}
+
+HLE("secur32.dll", FreeContextBuffer, 1) {
+  gaddr p = Arg(c, 0);
+  if (p) HeapFreeProcess(p);
+  return kSecEOk;
+}
+
+// ---- handshake -----------------------------------------------------------
+
+HLE("secur32.dll", InitializeSecurityContextA, 12) {
+  uint32_t cred_id = HandleId(Arg(c, 0));
+  bool first = Arg(c, 1) == 0;
+  std::string target = Arg(c, 2) ? GStr(Arg(c, 2)) : std::string();
+  uint32_t req_flags = Arg(c, 3);
+  gaddr in_desc = Arg(c, 6);
+  gaddr new_ctx = Arg(c, 8);
+  gaddr out_desc = Arg(c, 9);
+  gaddr out_flags = Arg(c, 10);
+
+  auto cred = FindCred(cred_id);
+  if (!cred) return kSecEInvalidHandle;
+  RECOMP_TRACE("secur32: InitializeSecurityContextA cred %u first %d target '%s'\n", cred_id, (int)first, target.c_str());
+
+  std::shared_ptr<TlsContext> cx;
+  if (first) {
+    if (!new_ctx) return kSecEInvalidParameter;
+    auto made = std::make_shared<TlsContext>();
+    made->cred = cred;
+    made->req_flags = req_flags;
+    made->ssl = SSL_new(cred->ssl_ctx);
+    if (made->ssl) {
+      // The caller moves the ciphertext itself: every record it receives is
+      // fed in through InitializeSecurityContext/DecryptMessage and every
+      // record the engine produces is returned as an output token.
+      made->rbio = BIO_new(BIO_s_mem());
+      made->wbio = BIO_new(BIO_s_mem());
+      if (!made->rbio || !made->wbio) {
+        LogOpenSsl("BIO_new");
+        SSL_free(made->ssl);
+        made->ssl = nullptr;
+        return kSecEInternalError;
+      }
+      SSL_set_bio(made->ssl, made->rbio, made->wbio);
+    }
+    if (!made->ssl || !made->rbio || !made->wbio) {
+      LogOpenSsl("SSL_new");
+      if (made->ssl) SSL_free(made->ssl);
+      return kSecEInternalError;
+    }
+    if (!target.empty() && !cred->no_name_check) {
+      if (!IsIpLiteral(target)) SSL_set_tlsext_host_name(made->ssl, target.c_str());
+      if (cred->verify) {
+        X509_VERIFY_PARAM* p = SSL_get0_param(made->ssl);
+        X509_VERIFY_PARAM_set_hostflags(p, X509_CHECK_FLAG_NO_PARTIAL_WILDCARDS);
+        X509_VERIFY_PARAM_set1_host(p, target.c_str(), 0);
+      }
+    }
+    SSL_set_connect_state(made->ssl);
+    uint32_t id;
+    {
+      std::lock_guard<std::mutex> l(g_mu);
+      id = NewId();
+      g_contexts[id] = made;
+    }
+    PutHandle(new_ctx, id);
+    cx = made;
+  } else {
+    cx = FindContext(HandleId(Arg(c, 1)));
+    if (!cx) return kSecEInvalidHandle;
+    cx->req_flags = req_flags;
+  }
+
+  std::vector<uint8_t> token;
+  uint32_t status = kSecIContinueNeeded;
+
+  if (cx->shutdown && !in_desc) {
+    ERR_clear_error();
+    int r = SSL_shutdown(cx->ssl);
+    token = Drain(cx->wbio);
+    status = r >= 0 ? kSecEOk : kSecEInternalError;
+    if (r < 0) LogOpenSsl("SSL_shutdown");
+  } else {
+    SecBuf in{kSecBufferEmpty, 0, 0};
+    bool have_in = false;
+    if (in_desc) {
+      uint32_t n = BufCount(in_desc);
+      for (uint32_t i = 0; i < n; i++) {
+        SecBuf b = GetBuf(in_desc, i);
+        if ((b.type == kSecBufferToken || b.type == kSecBufferData) && b.cb && b.ptr) {
+          in = b;
+          have_in = true;
+          break;
+        }
+      }
+    }
+    if (have_in) FeedRecords(*cx, in.ptr, in.cb);
+
+    ERR_clear_error();
+    int r = SSL_do_handshake(cx->ssl);
+    token = Drain(cx->wbio);
+    Reclaim(*cx);
+    uint32_t extra = ExtraBytes(*cx);
+    int err = r == 1 ? 0 : SSL_get_error(cx->ssl, r);
+    RECOMP_TRACE("secur32: SSL_do_handshake r %d err %d status %08X\n", r, err, status);
+    if (r == 1) {
+      status = kSecEOk;
+    } else if (err == SSL_ERROR_WANT_READ || err == SSL_ERROR_WANT_WRITE) {
+      // Nothing was consumed: the caller should add more ciphertext.
+      if (extra == in.cb && token.empty() && have_in)
+        status = kSecEIncompleteMessage;
+      else
+        status = kSecIContinueNeeded;
+    } else {
+      uint32_t v = VerifyStatus(cx->ssl);
+      status = v != kSecEOk ? v : kSecEInvalidToken;
+      LogOpenSsl("SSL_do_handshake");
+    }
+
+    // Report the unconsumed tail of the caller's ciphertext as EXTRA.
+    if (in_desc && have_in && BufCount(in_desc) > 1) {
+      uint32_t at = extra;
+      gaddr tail = in.ptr + (in.cb > at ? in.cb - at : 0);
+      SetBuf(in_desc, 1, at, at ? kSecBufferExtra : kSecBufferEmpty, at ? tail : 0);
+    }
+  }
+
+  uint32_t hn = BufCount(out_desc);
+  if (hn > 0) {
+    gaddr p = 0;
+    if (!token.empty()) {
+      p = HeapAllocProcess(token.size(), false);
+      std::memcpy(GPtr(p), token.data(), token.size());
+    }
+    SetBuf(out_desc, 0, uint32_t(token.size()), kSecBufferToken, p);
+    if (hn > 1) SetBuf(out_desc, 1, 0, kSecBufferEmpty, 0);
+  }
+  if (out_flags) Wr32(out_flags, cx->req_flags);
+  return status;
+}
+
+// ---- record layer --------------------------------------------------------
+
+HLE("secur32.dll", EncryptMessage, 4) {
+  auto cx = FindContext(HandleId(Arg(c, 0)));
+  if (!cx) return kSecEInvalidHandle;
+  gaddr desc = Arg(c, 2);
+  uint32_t n = BufCount(desc);
+  int hi = -1, di = -1, ti = -1;
+  for (uint32_t i = 0; i < n; i++) {
+    uint32_t t = GetBuf(desc, i).type;
+    if (t == kSecBufferStreamHeader) hi = int(i);
+    else if (t == kSecBufferData) di = int(i);
+    else if (t == kSecBufferStreamTrailer) ti = int(i);
+  }
+  if (di < 0) return kSecEInvalidParameter;
+  SecBuf data = GetBuf(desc, uint32_t(di));
+  if (!data.ptr) return kSecEInvalidParameter;
+  uint32_t hcap = hi >= 0 ? GetBuf(desc, uint32_t(hi)).cb : 0;
+  uint32_t tcap = ti >= 0 ? GetBuf(desc, uint32_t(ti)).cb : 0;
+  if (hcap < 5) return kSecEBufferTooSmall;
+
+  ERR_clear_error();
+  int r = SSL_write(cx->ssl, GPtr(data.ptr), int(data.cb));
+  RECOMP_TRACE("secur32: SSL_write r %d status %08X\n", r, SSL_get_error(cx->ssl, r));
+  if (r <= 0) {
+    LogOpenSsl("SSL_write");
+    return SSL_get_error(cx->ssl, r) == SSL_ERROR_WANT_WRITE ? kSecEBufferTooSmall
+                                                             : kSecEInternalError;
+  }
+  std::vector<uint8_t> rec = Drain(cx->wbio);
+  if (rec.size() < 5) return kSecEInternalError;
+  uint32_t body = uint32_t(rec.size() - 5);
+  if (body > data.cb + tcap) return kSecEBufferTooSmall;
+
+  gaddr hptr = GetBuf(desc, uint32_t(hi)).ptr;
+  std::memcpy(GPtr(hptr), rec.data(), 5);
+  uint32_t in_data = std::min(body, data.cb);
+  std::memcpy(GPtr(data.ptr), rec.data() + 5, in_data);
+  uint32_t in_trailer = body - in_data;
+  gaddr tptr = ti >= 0 ? GetBuf(desc, uint32_t(ti)).ptr : 0;
+  if (in_trailer && tptr) std::memcpy(GPtr(tptr), rec.data() + 5 + in_data, in_trailer);
+  SetBuf(desc, uint32_t(hi), 5, kSecBufferStreamHeader, hptr);
+  SetBuf(desc, uint32_t(di), in_data, kSecBufferData, data.ptr);
+  if (ti >= 0) SetBuf(desc, uint32_t(ti), in_trailer, kSecBufferStreamTrailer, tptr);
+  return kSecEOk;
+}
+
+HLE("secur32.dll", DecryptMessage, 4) {
+  auto cx = FindContext(HandleId(Arg(c, 0)));
+  if (!cx) return kSecEInvalidHandle;
+  gaddr desc = Arg(c, 2);
+  uint32_t n = BufCount(desc);
+  int di = -1;
+  for (uint32_t i = 0; i < n; i++) {
+    uint32_t t = GetBuf(desc, i).type;
+    if (t == kSecBufferData) di = int(i);
+  }
+  if (di < 0) return kSecEInvalidParameter;
+  SecBuf in = GetBuf(desc, uint32_t(di));
+  if (!in.ptr || !in.cb) return kSecEInvalidParameter;
+  FeedRecords(*cx, in.ptr, in.cb);
+
+  ERR_clear_error();
+  int r = SSL_read(cx->ssl, GPtr(in.ptr), int(in.cb));
+  Reclaim(*cx);
+  uint32_t extra = ExtraBytes(*cx);
+  RECOMP_TRACE("secur32: SSL_read r %d status %08X\n", r, SSL_get_error(cx->ssl, r));
+  if (r > 0) {
+    gaddr tail = in.ptr + (in.cb > extra ? in.cb - extra : 0);
+    if (n > 0) SetBuf(desc, 0, 0, kSecBufferStreamHeader, in.ptr);
+    if (n > 1) SetBuf(desc, 1, uint32_t(r), kSecBufferData, in.ptr);
+    if (n > 2) SetBuf(desc, 2, 0, kSecBufferStreamTrailer, 0);
+    if (n > 3) SetBuf(desc, 3, extra, extra ? kSecBufferExtra : kSecBufferEmpty, extra ? tail : 0);
+    return kSecEOk;
+  }
+  if (r == 0) {
+    if (n > 0) SetBuf(desc, 0, 0, kSecBufferStreamHeader, in.ptr);
+    if (n > 1) SetBuf(desc, 1, 0, kSecBufferEmpty, 0);
+    if (n > 3) SetBuf(desc, 3, extra, extra ? kSecBufferExtra : kSecBufferEmpty,
+                      extra ? in.ptr + (in.cb - extra) : 0);
+    return kSecIContextExpired;
+  }
+  int err = SSL_get_error(cx->ssl, r);
+  if (err == SSL_ERROR_WANT_READ || err == SSL_ERROR_WANT_WRITE) {
+    if (extra == in.cb) return kSecEIncompleteMessage;
+    // Whole non-application records (a ticket, a hello request) were
+    // consumed; hand the rest back and let the caller add more.
+    if (n > 1) SetBuf(desc, 1, 0, kSecBufferEmpty, 0);
+    if (n > 3)
+      SetBuf(desc, 3, extra, extra ? kSecBufferExtra : kSecBufferEmpty,
+             extra ? in.ptr + (in.cb - extra) : 0);
+    return kSecEOk;
+  }
+  LogOpenSsl("SSL_read");
+  uint32_t v = VerifyStatus(cx->ssl);
+  return v != kSecEOk ? v : kSecEInvalidToken;
+}
