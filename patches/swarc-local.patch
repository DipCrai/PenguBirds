+// ---- select and fd sets -----------------------------------------------------
+
+// A Windows fd_set is a count followed by that many SOCKETs; a host fd_set
+// is a bitmap of descriptors, so the two are translated through the handle
+// table.
+struct FdSetMap {
+  std::vector<uint32_t> guest;
+  std::vector<int> host;
+};
+
+bool ReadFdSet(gaddr va, FdSetMap* m) {
+  m->guest.clear();
+  m->host.clear();
+  if (!va) return true;
+  uint32_t n = Rd32(va);
+  if (n > 64) return false;
+  for (uint32_t i = 0; i < n; i++) {
+    uint32_t s = Rd32(va + 4 + 4 * i);
+    int fd = SocketFd(s);
+    if (fd < 0) return false;
+    m->guest.push_back(s);
+    m->host.push_back(fd);
+  }
+  return true;
+}
+
+void MakeHostSet(const FdSetMap& m, fd_set* out, int* max_fd) {
+  FD_ZERO(out);
+  for (int fd : m.host) {
+    FD_SET(fd, out);
+    if (fd + 1 > *max_fd) *max_fd = fd + 1;
+  }
+}
+
+void WriteFdSet(gaddr va, const FdSetMap& m, const fd_set* in) {
+  if (!va) return;
+  uint32_t n = 0;
+  for (size_t i = 0; i < m.host.size(); i++)
+    if (FD_ISSET(m.host[i], in)) Wr32(va + 4 + 4 * n++, m.guest[i]);
+  Wr32(va, n);
+}
+
+RECOMP_WS2(18, select, 5) {
+  FdSetMap r, w, e;
+  if (!ReadFdSet(Arg(c, 1), &r) || !ReadFdSet(Arg(c, 2), &w) ||
+      !ReadFdSet(Arg(c, 3), &e))
+    return Fail(kWsaENotSock);
+  fd_set hr, hw, he;
+  int max_fd = 0;
+  MakeHostSet(r, &hr, &max_fd);
+  MakeHostSet(w, &hw, &max_fd);
+  MakeHostSet(e, &he, &max_fd);
+  timeval tv{};
+  timeval* ptv = nullptr;
+  if (Arg(c, 4)) {
+    tv.tv_sec = int32_t(Rd32(Arg(c, 4)));
+    tv.tv_usec = int32_t(Rd32(Arg(c, 4) + 4));
+    ptv = &tv;
+  }
+  int rc = ::select(max_fd, &hr, &hw, &he, ptv);
+  if (rc < 0) return FailErrno();
+  WriteFdSet(Arg(c, 1), r, &hr);
+  WriteFdSet(Arg(c, 2), w, &hw);
+  WriteFdSet(Arg(c, 3), e, &he);
+  return uint64_t(uint32_t(rc));
+}
+
+// __WSAFDIsSet(s, set): non-zero if the socket is in the set.
+RECOMP_WS2(151, __WSAFDIsSet, 2) {
+  uint32_t s = uint32_t(Arg(c, 0)), va = Arg(c, 1);
+  if (!va) return 0;
+  uint32_t n = Rd32(va);
+  if (n > 64) return 0;
+  for (uint32_t i = 0; i < n; i++)
+    if (Rd32(va + 4 + 4 * i) == s) return 1;
+  return 0;
+}
+
+// ---- name resolution --------------------------------------------------------
+
+// Windows ADDRINFOA (x86 and x64: a 32-bit size_t in the guest): flags,
+// family, socktype, protocol, addrlen, canonname, addr, next.
+constexpr uint32_t kAiFlags = 0, kAiFamily = 4, kAiSocktype = 8, kAiProtocol = 12,
+                   kAiAddrlen = 16, kAiCanonname = 20, kAiAddr = 24, kAiNext = 28,
+                   kAiSize = 32;
+
+int HostAiFamily(uint32_t af) {
+  if (af == kAfInet) return AF_INET;
+  if (af == kAfInet6) return AF_INET6;
+  return AF_UNSPEC;
+}
+
+int HostAiFlags(uint32_t f) {
+  int h = 0;
+  if (f & 0x1) h |= AI_PASSIVE;
+  if (f & 0x2) h |= AI_CANONNAME;
+  if (f & 0x4) h |= AI_NUMERICHOST;
+#ifdef AI_NUMERICSERV
+  if (f & 0x8) h |= AI_NUMERICSERV;
+#endif
+#ifdef AI_ADDRCONFIG
+  if (f & 0x400) h |= AI_ADDRCONFIG;
+#endif
+#ifdef AI_V4MAPPED
+  if (f & 0x800) h |= AI_V4MAPPED;
+#endif
+#ifdef AI_ALL
+  if (f & 0x100) h |= AI_ALL;
+#endif
+  return h;
+}
+
+// getaddrinfo(name, service, hints, &result): the host resolver, then one
+// guest block holding every ADDRINFOA, its sockaddr and its canon name.
+RECOMP_WS2_NAME(getaddrinfo, 4) {
+  std::string node = Arg(c, 0) ? GStr(Arg(c, 0)) : std::string();
+  std::string service = Arg(c, 1) ? GStr(Arg(c, 1)) : std::string();
+  addrinfo hints{};
+  addrinfo* hp = nullptr;
+  if (Arg(c, 2)) {
+    gaddr h = Arg(c, 2);
+    hints.ai_flags = HostAiFlags(Rd32(h + kAiFlags));
+    hints.ai_family = HostAiFamily(Rd32(h + kAiFamily));
+    hints.ai_socktype = int32_t(Rd32(h + kAiSocktype));
+    hints.ai_protocol = int32_t(Rd32(h + kAiProtocol));
+    hp = &hints;
+  }
+  addrinfo* res = nullptr;
+  int rc = ::getaddrinfo(node.empty() ? nullptr : node.c_str(),
+                         service.empty() ? nullptr : service.c_str(), hp, &res);
+  std::string lower;
+  for (char ch : node) lower += char(std::tolower(static_cast<unsigned char>(ch)));
+  const bool activation =
+      (lower == "cloud.rovio.com" || lower == "drm-pc.angrybirdsgame.com") &&
+      (service.empty() || service == "80" || service == "http");
+  if (rc == 0 && activation) {
+    for (addrinfo* a = res; a; a = a->ai_next) {
+      if (a->ai_family != AF_INET || !a->ai_addr) continue;
+      auto* in = reinterpret_cast<sockaddr_in*>(a->ai_addr);
+      in->sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+      in->sin_port = htons(80);
+    }
+  }
+  gaddr out = Arg(c, 3);
+  if (rc != 0) {
+    if (out) Wr32(out, 0);
+    t_wsa_error = rc == EAI_AGAIN      ? kWsaETryAgain
+                  : rc == EAI_MEMORY   ? kWsaENoBufs
+                  : rc == EAI_SYSTEM   ? WsaError(errno)
+                                       : kWsaEHostNotFound;
+    return t_wsa_error;
+  }
+  size_t size = 0;
+  for (addrinfo* a = res; a; a = a->ai_next) {
+    size += kAiSize;
+    if (a->ai_family == AF_INET) size += 16;
+    if (a->ai_family == AF_INET6) size += 28;
+    if (a->ai_canonname) size += std::strlen(a->ai_canonname) + 1;
+  }
+  gaddr block = HeapAllocProcess(size, true);
+  gaddr p = block, prev = 0;
+  for (addrinfo* a = res; a; a = a->ai_next) {
+    gaddr node_va = p;
+    if (prev) Wr32(prev + kAiNext, node_va);
+    p += kAiSize;
+    uint8_t ab[28] = {};
+    uint32_t alen = 0;
+    if (a->ai_family == AF_INET && a->ai_addrlen >= sizeof(sockaddr_in)) {
+      auto* sa = reinterpret_cast<const sockaddr_in*>(a->ai_addr);
+      ab[0] = kAfInet;
+      std::memcpy(ab + 2, &sa->sin_port, 2);
+      std::memcpy(ab + 4, &sa->sin_addr, 4);
+      alen = 16;
+    } else if (a->ai_family == AF_INET6 &&
+               a->ai_addrlen >= sizeof(sockaddr_in6)) {
+      auto* sa = reinterpret_cast<const sockaddr_in6*>(a->ai_addr);
+      ab[0] = kAfInet6;
+      std::memcpy(ab + 2, &sa->sin6_port, 2);
+      std::memcpy(ab + 4, &sa->sin6_flowinfo, 4);
+      std::memcpy(ab + 8, &sa->sin6_addr, 16);
+      std::memcpy(ab + 24, &sa->sin6_scope_id, 4);
+      alen = 28;
+    }
+    gaddr addr_va = 0, name_va = 0;
+    if (alen) {
+      addr_va = p;
+      std::memcpy(GPtr(p), ab, alen);
+      p += alen;
+    }
+    if (a->ai_canonname) {
+      size_t n = std::strlen(a->ai_canonname) + 1;
+      name_va = p;
+      std::memcpy(GPtr(p), a->ai_canonname, n);
+      p += n;
+    }
+    Wr32(node_va + kAiFlags, uint32_t(a->ai_flags));
+    Wr32(node_va + kAiFamily, a->ai_family == AF_INET ? kAfInet
+                             : a->ai_family == AF_INET6 ? kAfInet6 : 0);
+    Wr32(node_va + kAiSocktype, uint32_t(a->ai_socktype));
+    Wr32(node_va + kAiProtocol, uint32_t(a->ai_protocol));
+    Wr32(node_va + kAiAddrlen, alen);
+    Wr32(node_va + kAiCanonname, name_va);
+    Wr32(node_va + kAiAddr, addr_va);
+    prev = node_va;
+  }
+  ::freeaddrinfo(res);
+  if (out) Wr32(out, block);
+  return 0;
+}
+
+RECOMP_WS2_NAME(freeaddrinfo, 1) {
+  if (Arg(c, 0)) HeapFreeProcess(Arg(c, 0));
+  return 0;
+}
