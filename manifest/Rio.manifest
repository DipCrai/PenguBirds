# recomp_lift manifest for Angry Birds Rio (PC).

# libmpg123 (statically linked): native replacement, addresses from
# the shared signature (feed = init + 0x440).

replace 004D5C30 mpg123_init
replace 004D64E0 mpg123_new
replace 004D6480 mpg123_delete
replace 004D6500 mpg123_open_feed
replace 004D6070 mpg123_feed
replace 004D60C0 mpg123_decode
replace 004D61E0 mpg123_getformat
replace 004D6240 mpg123_tell
replace 004D62F0 mpg123_feedseek

# Rio's old activator only enables its button for XXXX-XXXX-XXXX-XXXX.
# The legacy server accepted any key; this native replacement keeps that
# behaviour for the user's own copy (the endpoint itself is answered by
# the runtime's in-process DRM responder).
replace 004BB3B0 rio_key_ok
